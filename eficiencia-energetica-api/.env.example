# =========================================================================
# Variáveis de ambiente — copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
# =========================================================================

# --- Autenticação JWT ---
# Gere uma chave forte com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Senha do usuário de demonstração "fiscal" (usado para obter o token em /token).
USUARIO_DEMO_SENHA=fiscal123

# --- Serviço de IA 2 (LLM via Groq) — OPCIONAL ---
# Sem esta chave, o endpoint /api/v1/ia/resumir-analise usa fallback por regra.
# Chave gratuita em: https://console.groq.com/
GROQ_API_KEY=
